{
  "$comment": [
    "Per-agent model and provider configuration.",
    "API KEYS DO NOT BELONG HERE. 'apiKeyEnv' only names the GitHub Actions",
    "secret that carries the key. Add the secrets under:",
    "Settings -> Secrets and variables -> Actions -> New repository secret.",
    "",
    "provider: 'anthropic' | 'openai' (any OpenAI-compatible API, e.g. OpenRouter)",
    "baseUrl:  only needed for OpenAI-compatible providers"
  ],

  "defaults": {
    "provider": "anthropic",
    "temperature": 0.2,
    "maxTokens": 8192,
    "maxSteps": 40
  },

  "agents": {
    "po": {
      "model": "claude-opus-5",
      "apiKeyEnv": "PO_API_KEY",
      "temperature": 0.3,
      "maxSteps": 30
    },
    "dev": {
      "model": "claude-opus-5",
      "apiKeyEnv": "DEV_API_KEY",
      "temperature": 0.1,
      "maxSteps": 80
    },
    "qc": {
      "model": "claude-sonnet-5",
      "apiKeyEnv": "QC_API_KEY",
      "temperature": 0.0,
      "maxSteps": 50
    }
  },

  "policy": {
    "maxQcRounds": 3,
    "autoMerge": true,
    "maxTasksPerRun": 10,
    "baseBranch": "main"
  }
}
